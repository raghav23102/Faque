{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": "build/client",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!.*\\.(?:css|js|map|png|jpg|jpeg|gif|svg|ico|json|woff2?)).*)",
      "destination": "/api/index"
    }
  ]
}
