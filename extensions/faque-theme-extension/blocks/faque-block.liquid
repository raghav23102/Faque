<div class="faque-container" style="max-width: {{ block.settings.content_width }}px; margin: 0 auto; padding: {{ block.settings.spacing }}px 0;">
  {% if block.settings.heading != blank %}
    <h2 class="faque-heading" style="color: {{ block.settings.heading_color }};">{{ block.settings.heading }}</h2>
  {% endif %}
  
  <div class="faque-accordion" id="faque-{{ block.id }}">
    <!-- Dynamic FAQ items will be fetched/rendered here via App Proxy or Metafields -->
    <details class="faque-item" style="border: 1px solid {{ block.settings.border_color }}; border-radius: {{ block.settings.border_radius }}px; margin-bottom: 10px;">
      <summary style="padding: 15px; font-weight: bold; cursor: pointer; color: {{ block.settings.question_color }}; background-color: {{ block.settings.background_color }};">
        Example Question?
      </summary>
      <div class="faque-content" style="padding: 15px; border-top: 1px solid {{ block.settings.border_color }}; color: {{ block.settings.answer_color }}; background-color: {{ block.settings.background_color }};">
        This is an example answer. Configure the Faque App to show real content here.
      </div>
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Faque Section",
  "target": "section",
  "stylesheet": "faque.css",
  "javascript": "faque.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer Color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#dddddd"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Content Width",
      "default": 800
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical Spacing",
      "default": 40
    }
  ]
}
{% endschema %}
