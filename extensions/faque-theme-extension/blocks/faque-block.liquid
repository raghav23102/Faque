<div class="faque-app-proxy-container" id="faque-container-{{ block.id }}" style="max-width: {{ block.settings.content_width }}px; margin: 0 auto; padding: {{ block.settings.spacing }}px 0;">
  {% if block.settings.faq_id == blank %}
    <div style="padding: 20px; text-align: center; border: 1px dashed #ccc; background: #f9f9f9;">
      <strong>Faque App:</strong> Please enter an FAQ ID in the block settings to display your FAQ.
    </div>
  {% else %}
    <div class="faque-loading" style="text-align: center; padding: 20px;">
      Loading FAQ...
    </div>
  {% endif %}
</div>

{% if block.settings.faq_id != blank %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const containerId = 'faque-container-{{ block.id }}';
    const container = document.getElementById(containerId);
    const faqId = '{{ block.settings.faq_id }}';
    
    // Shopify App Proxies are available at the subpath defined in shopify.app.toml
    // prefix = apps, subpath = faque -> /apps/faque
    fetch('/apps/faque/faq?faqId=' + encodeURIComponent(faqId))
      .then(response => {
        if (!response.ok) throw new Error('Failed to load FAQ');
        return response.text();
      })
      .then(html => {
        container.innerHTML = html;
        
        // We must re-execute any scripts returned by the proxy because innerHTML doesn't execute script tags
        const scripts = container.querySelectorAll('script');
        scripts.forEach(oldScript => {
          const newScript = document.createElement('script');
          Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
          newScript.appendChild(document.createTextNode(oldScript.innerHTML));
          oldScript.parentNode.replaceChild(newScript, oldScript);
        });
      })
      .catch(err => {
        console.error('Faque App Error:', err);
        container.innerHTML = '<div style="color: red; padding: 20px;">Failed to load FAQ. Please check your FAQ ID.</div>';
      });
  });
</script>
{% endif %}

{% schema %}
{
  "name": "Faque Section",
  "target": "section",
  "stylesheet": "faque.css",
  "javascript": "faque.js",
  "settings": [
    {
      "type": "text",
      "id": "faq_id",
      "label": "FAQ ID",
      "info": "Copy and paste the FAQ ID from the Faque App Dashboard."
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Content Width",
      "default": 800
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical Spacing",
      "default": 40
    }
  ]
}
{% endschema %}
